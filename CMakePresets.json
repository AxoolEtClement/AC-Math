{
	"version": 3,
	"cmakeMinimumRequired": {
		"major": 3
	},
	"configurePresets": [
		{
			"name": "default",
			"displayName": "Default Ninja Build (x64)",
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build",
			"architecture": {
				"value": "x64",
				"strategy": "external"
			},
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			}
		}
	]
}