#include "mathLibSIMD/include/Vec3f.hpp"
#include "mathLibSIMD/include/Vec4.hpp"
#include "mathLibSIMD/include/Mat3.hpp"
#include "mathLibSIMD/include/Mat4x4.hpp"
#include "mathLibSIMD/include/Vec4SOA.hpp"

#include <algorithm>
#include <array>
